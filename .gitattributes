# Normalise line endings so the repo is consistent across Windows/Linux.
* text=auto eol=lf

# Notebooks are JSON - keep them intact and mark them for GitHub language stats.
*.ipynb text linguist-language=Jupyter\ Notebook

# Binary assets - never try to diff or merge these.
*.png binary
*.pdf binary

# NOTE: this project deliberately does NOT commit model artifacts
# (*.pkl, *.pt). They live in data/processed/, are ~403 MB, and are
# fully regenerated by the seeded pipeline. Git LFS is therefore not
# configured - see .gitignore for the rebuild commands.
