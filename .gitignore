venv/
.venv/
env/
ENV/

# =========================================================
# Derived model artifacts
# ---------------------------------------------------------
# data/processed/ holds ~403 MB of .pkl and .pt files that are
# fully regenerated by the documented pipeline in ~10 minutes.
# The generator is seeded, so a rebuild reproduces them exactly.
# Committing them would consume 40% of the free Git LFS storage
# quota and burn the monthly bandwidth allowance on a single clone.
#
# Rebuild with:
#   python synthetic_data/generate_synthetic_data.py
#   python src/preprocessing.py
#   python src/content_based_nlp.py
#   python models/baseline_recommenders.py
#   python src/collaborative_filtering.py
#   python models/ncf_recommender.py
# =========================================================
data/processed/
artifacts/
checkpoints/
*.pkl
*.pt
*.pth
*.joblib
*.h5
*.keras

# Raw data IS committed - it is small (~9 MB) and lets a reviewer
# inspect the dataset without running the generator first.
!data/raw/*.csv

